{
  "background_color": "#ffffff",
  "categories": [
    "utilities",
    "productivity"
  ],
  "description": "Convert images, PDFs, text, PPT & Word files free — right in your browser. Made by Akram Khan.",
  "display": "standalone",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/",
  "name": "AK TOOLS — All in One File Converter",
  "orientation": "portrait",
  "scope": "/",
  "short_name": "AK TOOLS",
  "start_url": "/",
  "theme_color": "#0F172A",
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "shared_file",
          "accept": [
            "image/*",
            "application/pdf"
          ]
        }
      ]
    }
  }
}